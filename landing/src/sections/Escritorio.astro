---
import MiniDesk from '../components/MiniDesk.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const t = useTranslations(getLangFromUrl(Astro.url));

const feats = [
  { t: t('escritorio.f1.title'), b: t('escritorio.f1.body') },
  { t: t('escritorio.f2.title'), b: t('escritorio.f2.body') },
  { t: t('escritorio.f3.title'), b: t('escritorio.f3.body') },
];
---

<section class="u-section esc__section" id="escritorio">
  <div class="esc__container">
    <div class="u-head" data-reveal>
      <p class="u-kicker">{t('escritorio.kicker')}</p>
      <h2>{t('escritorio.title')}</h2>
      <p>{t('escritorio.lead')}</p>
    </div>

    <div class="esc__stage" data-reveal>
      <MiniDesk />
    </div>

    <ul class="esc__feats">
      {
        feats.map((f, i) => (
          <li class="esc__feat" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <span class="esc__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{f.t}</h3>
              <p>{f.b}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* La sección del escritorio respira más que el resto de la página: contenedor
     propio más ancho (hasta ~108rem) para que el mock del escritorio —con su
     riel a la izquierda y las tarjetas— tenga espacio real, no el ancho de
     lectura del copy. */
  .esc__container {
    width: 100%;
    max-width: 108rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 0.5rem + 3vw, 2.5rem);
  }

  .esc__stage {
    margin-bottom: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }

  .esc__feats {
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 52rem) {
    .esc__feats { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  }
  .esc__feat {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-content: start;
  }
  .esc__num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ab-primary);
    padding-top: 0.2rem;
  }
  .esc__feat h3 { font-size: var(--text-h3); }
  .esc__feat p {
    margin-top: 0.4rem;
    color: var(--color-muted-foreground);
    font-size: 0.95rem;
  }
</style>
