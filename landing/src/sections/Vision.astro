---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const t = useTranslations(getLangFromUrl(Astro.url));

const pillars = [
  { t: t('idea.p1.t'), b: t('idea.p1.b'), icon: '<rect x="3" y="4" width="7" height="7" rx="1.2"/><rect x="14" y="4" width="7" height="7" rx="1.2"/><rect x="3" y="15" width="7" height="5" rx="1.2"/><rect x="14" y="15" width="7" height="5" rx="1.2"/>' },
  { t: t('idea.p2.t'), b: t('idea.p2.b'), icon: '<path d="M12 3l9 16H3z"/><path d="M12 10v4M12 17h.01"/>' },
  { t: t('idea.p3.t'), b: t('idea.p3.b'), icon: '<path d="M21 12a8 8 0 1 1-3.2-6.4"/><path d="M21 4v5h-5"/>' },
];
---

<section class="u-section" id="idea">
  <div class="u-container">
    <div class="idea__lead" data-reveal>
      <p class="u-kicker">{t('idea.kicker')}</p>
      <h2>{t('idea.title')}</h2>
      <p class="idea__body">{t('idea.body')}</p>
      <p class="idea__close">{t('idea.close')}</p>
    </div>

    <div class="idea__pillars">
      {
        pillars.map((p, i) => (
          <article class="idea__pillar" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span class="idea__chip" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
            </span>
            <h3>{p.t}</h3>
            <p>{p.b}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .idea__lead {
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .idea__lead h2 {
    font-size: var(--text-h2);
    margin-top: 0.9rem;
  }
  .idea__body {
    margin-top: 1.2rem;
    font-size: var(--text-lead);
    color: var(--color-muted-foreground);
  }
  .idea__close {
    margin-top: 1.2rem;
    font-size: var(--text-lead);
    font-weight: 500;
  }

  .idea__pillars {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 52rem) {
    .idea__pillars { grid-template-columns: repeat(3, 1fr); }
  }

  .idea__pillar {
    border-top: 2px solid var(--ab-primary-line);
    padding-top: 1.25rem;
  }
  .idea__chip {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.55rem;
    background: var(--ab-primary-soft);
    color: var(--ab-primary);
    margin-bottom: 0.9rem;
  }
  .idea__pillar h3 { font-size: var(--text-h3); }
  .idea__pillar p {
    margin-top: 0.5rem;
    color: var(--color-muted-foreground);
    font-size: 0.95rem;
  }
</style>
