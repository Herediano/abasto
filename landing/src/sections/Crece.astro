---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const t = useTranslations(getLangFromUrl(Astro.url));
---

<section class="u-section u-section--tint" id="crece">
  <div class="u-container">
    <div class="u-head" data-reveal>
      <p class="u-kicker">{t('crece.kicker')}</p>
      <h2>{t('crece.title')}</h2>
      <p>{t('crece.lead')}</p>
    </div>

    <div class="crece__row">
      <article class="u-card crece__card" data-reveal>
        <span class="crece__tag">01</span>
        <h3>{t('crece.small.title')}</h3>
        <p>{t('crece.small.body')}</p>
        <ul class="crece__chips">
          <li>1 sucursal</li>
          <li>1 usuario</li>
          <li data-off>lotes</li>
          <li data-off>cuenta corriente</li>
        </ul>
      </article>

      <div class="crece__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </div>

      <article class="u-card crece__card" data-reveal style="--reveal-delay:80ms">
        <span class="crece__tag">N</span>
        <h3>{t('crece.big.title')}</h3>
        <p>{t('crece.big.body')}</p>
        <ul class="crece__chips">
          <li data-on>sucursales</li>
          <li data-on>rangos</li>
          <li data-on>cuenta corriente</li>
          <li data-on>pesables</li>
          <li data-on>factura A</li>
        </ul>
      </article>
    </div>

    <p class="crece__foot" data-reveal>{t('crece.foot')}</p>
  </div>
</section>

<style>
  .crece__row {
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }
  @media (min-width: 60rem) {
    .crece__row { grid-template-columns: 1fr auto 1fr; }
  }
  .crece__arrow {
    display: grid;
    place-items: center;
    color: var(--color-faint);
    transform: rotate(90deg);
  }
  @media (min-width: 60rem) { .crece__arrow { transform: none; } }

  .crece__card { position: relative; }
  .crece__tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ab-primary);
  }
  .crece__card h3 {
    font-size: var(--text-h3);
    margin-top: 0.5rem;
  }
  .crece__card p {
    margin-top: 0.6rem;
    color: var(--color-muted-foreground);
    font-size: 0.95rem;
  }
  .crece__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.1rem;
  }
  .crece__chips li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-muted-foreground);
  }
  .crece__chips li[data-off] {
    opacity: 0.4;
    text-decoration: line-through;
  }
  .crece__chips li[data-on] {
    border-color: var(--ab-primary-line);
    background: var(--ab-primary-soft);
    color: var(--ab-primary);
  }
  .crece__foot {
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-faint);
    max-width: 40rem;
  }
</style>
