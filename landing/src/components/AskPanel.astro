---
/*
 * Maqueta del buscador Ctrl+K de Abasto respondiendo una pregunta del negocio.
 * Es la "capa de IA" jugada a fondo: pregunta en lenguaje natural → respuesta
 * con un gráfico como el del módulo Ventas.  Marketing aspiracional: esta capa
 * todavía no está construida en el producto.
 */
import Sparkbars from './Sparkbars.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const days = t('ask.days').split(',');
const values = [58, 61, 44, 66, 72, 96, 70];
const highlight = 5; // sábado
---

<div class="ask" role="img" aria-label={lang === 'es'
  ? 'El buscador de Abasto: alguien pregunta cómo vienen las ventas de la semana y el sistema responde con un texto y un gráfico de barras'
  : 'Abasto’s command bar: someone asks how the week’s sales are going and the system answers with a sentence and a bar chart'}>
  <div class="ask__prompt">
    <svg class="ask__spark" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 2c.9 5.6 3.4 8.1 9 9-5.6.9-8.1 3.4-9 9-.9-5.6-3.4-8.1-9-9 5.6-.9 8.1-3.4 9-9Z"/></svg>
    <span class="ask__q">{t('ask.q')}<span class="ask__caret" aria-hidden="true"></span></span>
    <kbd class="ask__kbd">Ctrl K</kbd>
  </div>

  <div class="ask__answer">
    <span class="ask__tag">{t('preguntar.tag')}</span>
    <p class="ask__a">{t('ask.a')}</p>

    <div class="ask__chart">
      <p class="ask__chart-title">{t('ask.chart')}</p>
      <Sparkbars values={values} labels={days} highlight={highlight} height={72} />
    </div>
  </div>
</div>

<style>
  .ask {
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-card);
    box-shadow: var(--shadow-hero);
    overflow: hidden;
  }

  .ask__prompt {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 1rem 1.15rem;
    border-bottom: 1px solid var(--color-border-soft);
  }
  .ask__spark { color: var(--ab-primary); flex-shrink: 0; }
  .ask__q {
    flex: 1;
    font-size: 1.02rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
  }
  .ask__caret {
    width: 2px;
    height: 1.1em;
    margin-left: 3px;
    background: var(--ab-primary);
    animation: ask-blink 1.1s step-end infinite;
  }
  @keyframes ask-blink { 50% { opacity: 0; } }
  .ask__kbd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    color: var(--color-muted-foreground);
    flex-shrink: 0;
  }

  .ask__answer { padding: 1.15rem; }
  .ask__tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: var(--ab-primary-soft);
    color: var(--ab-primary);
    border: 1px solid var(--ab-primary-line);
  }
  .ask__a {
    margin-top: 0.8rem;
    font-size: 1rem;
    line-height: 1.55;
  }

  .ask__chart {
    margin-top: 1.1rem;
    padding: 0.9rem 1rem 0.7rem;
    border-radius: var(--radius-md);
    background: var(--color-subtle);
    border: 1px solid var(--color-border-soft);
  }
  .ask__chart-title {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted-foreground);
    margin-bottom: 0.6rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .ask__caret { animation: none; }
  }
</style>
