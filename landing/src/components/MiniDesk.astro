---
/*
 * Maqueta del escritorio real de Abasto — lo más fiel posible al diseño del
 * código (frontend/src/pages/escritorio-page.tsx y components/layout/sidebar.tsx):
 *   riel lateral (se despliega al clic, solo para mostrar)  →  marca + saludo +
 *   controles  →  "Mostrador" (caja)  →  grilla de tarjetas: cada módulo con su
 *   matiz en la pastilla del ícono y en el motivo de fondo; la cáscara es
 *   neutra — borde y sombra Uiverse (cian desplazado), el color es del módulo.
 *   Ver docs/diseno.md, "Color por módulo".
 *
 * El Preguntar ya no es una pill de la barra: es el botón flotante (Ctrl K)
 * que se asoma arriba al centro (PreguntarFlotante en el sistema).
 * Los pendientes viven en la campana; el Mostrador es su propio botón.
 * Los matices (--hue) son los exactos de frontend/src/lib/modules.tsx.
 */
import Sparkbars from './Sparkbars.astro';
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);

type Tile = {
  key: string;
  name: { es: string; en: string };
  hue: string;
  data: { es: string; en: string } | string;
  hint: { es: string; en: string };
  dot?: 'warn' | 'hot';
  icon: string;
  motif: string;
};

const tiles: Tile[] = [
  {
    key: 'ventas', name: { es: 'Ventas', en: 'Sales' }, hue: 'oklch(0.60 0.20 240)',
    data: '$ 58 k', hint: { es: '−36 % vs ayer · 4 tickets hoy', en: '−36% vs yesterday · 4 tickets today' },
    icon: '<rect x="4" y="3" width="13" height="18" rx="1.5"/><path d="M8 8h5M8 12h5M8 16h3"/>',
    motif: '<path d="M3 21V13M9 21V7M15 21v-6M21 21V4"/>',
  },
  {
    key: 'clientes', name: { es: 'Clientes', en: 'Customers' }, hue: 'oklch(0.60 0.20 330)',
    data: '$ 288 k', hint: { es: 'En la calle · 1 cliente vencido', en: 'Owed · 1 account overdue' }, dot: 'hot',
    icon: '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0M16 6.5a3 3 0 0 1 0 6"/>',
    motif: '<circle cx="8" cy="8" r="3.4"/><path d="M2 21c.8-4.4 3.6-6.6 6-6.6S13.2 16.6 14 21"/><circle cx="17" cy="9" r="2.6"/><path d="M15 21c.4-2.6 1.4-4.4 3-5.2"/>',
  },
  {
    key: 'stock', name: { es: 'Stock', en: 'Stock' }, hue: 'oklch(0.60 0.20 20)',
    data: { es: '2 bajo mínimo', en: '2 below min' },
    hint: { es: 'Coca cola 2.25l retornable, papel higiénico elegante x4', en: 'Coke 2.25l returnable, Elegante toilet paper x4' }, dot: 'hot',
    icon: '<path d="M3 8l9-4 9 4-9 4-9-4z"/><path d="M3 8v8l9 4 9-4V8"/>',
    motif: '<path d="M3 8l9-4 9 4-9 4-9-4z"/><path d="M3 8v8l9 4 9-4V8M12 12v8"/>',
  },
  {
    key: 'vencimientos', name: { es: 'Vencimientos', en: 'Expiry' }, hue: 'oklch(0.60 0.20 85)',
    data: '4 lotes', hint: { es: 'Vencen en ≤ 2 días · jamón cocido cagnoli feteado x kg', en: 'Expire within 2 days · sliced cooked ham per kg' }, dot: 'warn',
    icon: '<rect x="4" y="4" width="16" height="17" rx="1.5"/><path d="M4 9h16M9 3v4M15 3v4"/>',
    motif: '<rect x="4" y="4" width="16" height="17" rx="1.5"/><path d="M4 9h16M9 3v4M15 3v4M14 14l4 4M18 14l-4 4"/>',
  },
  {
    key: 'turnos', name: { es: 'Turnos de caja', en: 'Cash shifts' }, hue: 'oklch(0.60 0.20 285)',
    data: { es: '1 turno abierto', en: '1 shift open' }, hint: { es: 'Aperturas, cierres y arqueos', en: 'Opens, closes and counts' },
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2.5"/>',
    motif: '<circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2.5"/>',
  },
  {
    key: 'reposicion', name: { es: 'Reposición', en: 'Restock' }, hue: 'oklch(0.60 0.20 50)',
    data: '2', hint: { es: 'Productos para pedir', en: 'Products to reorder' }, dot: 'warn',
    icon: '<path d="M4 12a8 8 0 0 1 8-8c3 0 5.6 1.7 7 4M20 4v4h-4"/><path d="M20 12a8 8 0 0 1-8 8c-3 0-5.6-1.7-7-4M4 20v-4h4"/>',
    motif: '<path d="M4 12a8 8 0 018-8c3 0 5.6 1.7 7 4M20 4v4h-4"/><path d="M20 12a8 8 0 01-8 8c-3 0-5.6-1.7-7-4M4 20v-4h4"/>',
  },
  {
    key: 'productos', name: { es: 'Productos', en: 'Products' }, hue: 'oklch(0.60 0.20 160)',
    data: '5.963', hint: { es: 'Activos · 5928 sin categoría · 5928 sin precio', en: 'Active · 5928 uncategorised · 5928 no price' },
    icon: '<rect x="3" y="3" width="18" height="18" rx="1.5"/><path d="M7 3v18M11 3v18M15 7h6M15 12h6M15 16h6"/>',
    motif: '<rect x="3" y="3" width="18" height="18" rx="1.5"/><path d="M7 3v18M11 3v18M15 7h6M15 12h6M15 16h6"/>',
  },
  {
    key: 'precios', name: { es: 'Precios', en: 'Prices' }, hue: 'oklch(0.60 0.20 125)',
    data: { es: 'Sin pendientes', en: 'Nothing pending' }, hint: { es: 'Costos trasladados a precio', en: 'Costs carried into prices' },
    icon: '<path d="M3 12V4h8l10 10-8 8L3 12z"/><circle cx="8" cy="9" r="1.8"/>',
    motif: '<path d="M3 12V4h8l10 10-8 8L3 12z"/><circle cx="8" cy="9" r="1.8"/>',
  },
  {
    key: 'proveedores', name: { es: 'Proveedores', en: 'Suppliers' }, hue: 'oklch(0.60 0.20 195)',
    data: '4', hint: { es: 'Proveedores activos', en: 'Active suppliers' },
    icon: '<path d="M2 7h12v10H2zM14 10h4l4 4v3h-8z"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>',
    motif: '<path d="M2 7h12v10H2zM14 10h4l4 4v3h-8z"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>',
  },
  {
    key: 'depositos', name: { es: 'Depósitos', en: 'Warehouses' }, hue: 'oklch(0.55 0.03 255)',
    data: '3', hint: { es: 'Dónde se guarda el stock de la sucursal', en: 'Where the branch keeps its stock' },
    icon: '<path d="M3 21V9l9-5 9 5v12M3 21h18M9 21v-6h6v6"/>',
    motif: '<path d="M3 21V9l9-5 9 5v12M3 21h18M9 21v-6h6v6"/>',
  },
];

/* El riel muestra los saltos del sistema: Escritorio + módulos, salvo los que
   el sidebar real filtra (vencimientos, reposición). frontend/.../sidebar.tsx */
const sideItems = [
  {
    key: 'escritorio', name: { es: 'Escritorio', en: 'Desk' }, hue: 'var(--ab-primary)', active: true,
    icon: '<path d="M3 10.9 12 3l9 7.9"/><path d="M5.5 9.5V21h13V9.5"/><path d="M10 21v-6h4v6"/>',
  },
  ...tiles
    .filter(t => !['vencimientos', 'reposicion'].includes(t.key))
    .map(t => ({ key: t.key, name: t.name, hue: t.hue, active: false, icon: t.icon })),
];

const L = {
  es: {
    company: 'Autoservicio Belgrano', coin: 'B', date: 'Domingo, 6 de septiembre', greet: 'Buen día, Gaston.',
    ask: 'Preguntar', notif: 'Notificaciones', cuenta: 'Gaston', casa: 'Casa Central',
    mostrador: 'Mostrador', cajaAbierta: true, cajaLinea: 'Abierta 08:12 · 12 tickets · $4.500 en efectivo',
    sideOpen: 'Ocultar barra lateral', sideClosed: 'Mostrar barra lateral',
  },
  en: {
    company: 'Autoservicio Belgrano', coin: 'B', date: 'Sunday, 6 September', greet: 'Morning, Gaston.',
    ask: 'Ask', notif: 'Notifications', cuenta: 'Gaston', casa: 'Casa Central',
    mostrador: 'Register', cajaAbierta: true, cajaLinea: 'Open 08:12 · 12 tickets · $4,500 in cash',
    sideOpen: 'Hide sidebar', sideClosed: 'Show sidebar',
  },
}[lang];

const ventasBars = [58, 61, 44, 66, 72, 96, 70];
---

<div class="desk" data-side-open-label={L.sideOpen} data-side-closed-label={L.sideClosed} aria-label={lang === 'es'
  ? 'El escritorio de Abasto: la marca, el saludo, el mostrador con la caja abierta y una tarjeta por módulo con su número'
  : "Abasto's desk: the brand, the greeting, the open register and one card per module with its number"}>

  <!-- Riel lateral: el botón despliega la columna de saltos; es solo la maqueta,
       no navega (igual que la sidebar real, pero sin funciones). -->
  <div class="desk__side">
    <button
      type="button"
      class="desk__rail"
      data-desk-rail
      aria-expanded="false"
      aria-controls="desk-side-nav"
      aria-label={L.sideClosed}
      title={L.sideClosed}
    >
      <svg class="desk__rail-icon" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg class="desk__rail-x" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <div class="desk__sidereveal">
      <div class="desk__sideclip">
        <nav id="desk-side-nav" class="desk__sidenav" aria-label={lang === 'es' ? 'Módulos' : 'Modules'}>
          {
            sideItems.map((it, i) => (
              <span
                class:list={['desk__sitem', it.active && 'is-active']}
                style={`--i:${i}; --hue:${it.hue}`}
                title={it.name[lang]}
              >
                <span class="desk__sitem-bar" aria-hidden="true"></span>
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={it.icon} />
                <span class="desk__sitem-label">{it.name[lang]}</span>
              </span>
            ))
          }
        </nav>
      </div>
    </div>
  </div>

  <header class="desk__bar">
    <div class="desk__brand">
      <span class="desk__logo" aria-hidden="true">{L.coin}</span>
      <div>
        <p class="desk__company">{L.company}</p>
        <p class="desk__brandline">abasto<span>.ai</span></p>
      </div>
    </div>
    <div class="desk__controls" aria-hidden="true">
      <span class="desk__ctl desk__bell">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
      </span>
      <span class="desk__ctl desk__user">
        <span class="desk__avatar">G</span>
        <span class="desk__uname">{L.cuenta}</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
      </span>
    </div>
  </header>

  <p class="desk__date">{L.date}</p>
  <p class="desk__greet">{L.greet}</p>

  <div class="desk__mostrador" aria-hidden="true">
    <span class="desk__mostrador-top">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="1.5"/><path d="M6 7V4h12v3M7 11h1M10 11h1M13 11h1M16 11h1M8 15h8"/></svg>
      {L.mostrador}
      <span class="desk__blink" />
    </span>
    <span class="desk__mostrador-line">{L.cajaLinea}</span>
  </div>

  <div class="desk__grid">
    {
      tiles.map((tl) => (
        <article class="desk__tile" style={`--hue:${tl.hue}`}>
          <svg class="desk__motif" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={tl.motif} />
          {tl.dot && <span class:list={['desk__dot', `desk__dot--${tl.dot}`]} aria-hidden="true" />}
          <div class="desk__tile-top">
            <span class="desk__chip" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={tl.icon} />
            </span>
            <p class="desk__name">{tl.name[lang]}</p>
          </div>
          <div class="desk__tile-body">
            <p class="desk__data">{typeof tl.data === 'string' ? tl.data : tl.data[lang]}</p>
            <p class="desk__hint">{tl.hint[lang]}</p>
            {tl.key === 'ventas' && (
              <div class="desk__spark">
                <Sparkbars values={ventasBars} highlight={5} color={tl.hue} height={26} />
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>

  <span class="desk__ask" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 3c.6 3.9 2.1 6.4 6 7.5-3.9 1.1-5.4 3.6-6 7.9-.6-4.3-2.1-6.8-6-7.9 3.9-1.1 5.4-3.6 6-7.5z"/><path d="M19 14c.3 1.9 1 3.1 3 3.7-2 .6-2.7 1.8-3 3.9-.3-2.1-1-3.3-3-3.9 2-.6 2.7-1.8 3-3.7z"/></svg>
  </span>
</div>

<script>
  const desk = document.querySelector('[data-desk-rail]')?.closest('.desk');
  if (desk) {
    const rail = desk.querySelector('[data-desk-rail]');
    let cascade = false;
    rail?.addEventListener('click', () => {
      const open = desk.hasAttribute('data-side-open');
      if (open) {
        desk.removeAttribute('data-side-open');
      } else {
        if (!cascade) { cascade = true; desk.setAttribute('data-cascade', ''); }
        desk.setAttribute('data-side-open', '');
      }
      rail.setAttribute('aria-expanded', String(!open));
      rail.setAttribute(
        'aria-label',
        open ? (desk.dataset.sideClosedLabel ?? '') : (desk.dataset.sideOpenLabel ?? ''),
      );
      rail.setAttribute(
        'title',
        open ? (desk.dataset.sideClosedLabel ?? '') : (desk.dataset.sideOpenLabel ?? ''),
      );
    });
  }
</script>

<style>
  .desk {
    position: relative;
    border-radius: var(--radius-lg);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-hero);
    padding: clamp(1.4rem, 1.1rem + 1.5vw, 2.4rem);
    container-type: inline-size;
  }

  /* ===== Riel lateral =====
     Réplica de la sidebar real (fixed left-4 top-4): el botón es la cabeza del
     riel, el rail crece hacia abajo en cascada con grid-template-rows 0fr→1fr.
     Flota sobre el contenido —no lo empuja—. El estado vive en data-side-open. */
  .desk__side {
    position: absolute;
    left: clamp(0.6rem, 0.4rem + 0.6vw, 1rem);
    top: clamp(0.6rem, 0.4rem + 0.6vw, 1rem);
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .desk__rail {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-md);
    background: var(--color-card);
    border: 1px solid var(--border-uiverse);
    box-shadow: var(--shadow-uiverse);
    transform: translateY(1px);
    color: var(--color-muted-foreground);
    transition: box-shadow 0.2s ease, transform 0.2s ease, color 0.2s ease;
    cursor: pointer;
  }
  .desk__rail:hover {
    box-shadow: var(--shadow-uiverse-hover);
    transform: translateY(-2px);
  }
  .desk__rail:active { transform: translateY(0); }
  .desk[data-side-open] .desk__rail {
    background: var(--ab-primary);
    border-color: var(--ab-primary);
    color: var(--ab-on-solid);
  }
  .desk__rail-x { display: none; }
  .desk[data-side-open] .desk__rail-icon { display: none; }
  .desk[data-side-open] .desk__rail-x { display: block; }

  .desk__sidereveal {
    margin-top: 0.5rem;
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 280ms cubic-bezier(0.2, 0, 0, 1), opacity 120ms linear;
  }
  .desk[data-side-open] .desk__sidereveal {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .desk__sideclip {
    min-height: 0;
    overflow: hidden;
  }
  .desk__sidenav {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 3.25rem;
    padding: 0.4rem;
    border-radius: var(--radius-md);
    background: var(--color-card);
    border: 1px solid var(--border-uiverse);
    box-shadow: var(--shadow-uiverse);
  }
  .desk__sitem {
    position: relative;
    display: grid;
    place-items: center;
    height: 2.9rem;
    border-radius: var(--radius-md);
    color: var(--color-muted-foreground);
    transform: translateY(1px);
    box-shadow: none;
    transition: box-shadow 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }
  .desk__sitem:hover {
    box-shadow: var(--shadow-uiverse-hover);
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--hue) 8%, var(--color-card));
  }
  .desk__sitem svg {
    color: var(--hue);
    transition: opacity 0.15s ease;
  }
  .desk__sitem.is-active {
    background: color-mix(in srgb, var(--hue) 14%, transparent);
    color: var(--color-foreground);
  }
  .desk__sitem.is-active svg { stroke-width: 2.1; }
  .desk__sitem-bar {
    position: absolute;
    left: 0.1rem;
    top: 0.35rem;
    bottom: 0.35rem;
    width: 0.2rem;
    border-radius: 99px;
    background: var(--hue);
    opacity: 0;
    transform: scaleY(0.4);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .desk__sitem.is-active .desk__sitem-bar, .desk__sitem:hover .desk__sitem-bar {
    opacity: 1;
    transform: none;
  }
  /* El nombre del módulo aparece a la derecha al pasar el mouse (igual que en
     el sistema: el ítem se "expande" sin empujar a los demás). */
  .desk__sitem-label {
    position: absolute;
    left: calc(100% + 0.5rem);
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-card);
    box-shadow: var(--shadow-float);
    padding: 0.3rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-foreground);
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms ease;
  }
  .desk__sitem:hover .desk__sitem-label { opacity: 1; }

  /* Entrada en cascada al abrir el riel — solo al abrir con el clic (data-cascade
     se setea por JS al primer despliegue), nunca al cargar la página. */
  .desk[data-cascade] .desk__sitem {
    animation: desk-side-in 240ms cubic-bezier(0.2, 0, 0, 1) both;
    animation-delay: calc(var(--i) * 22ms);
  }
  @keyframes desk-side-in {
    from { opacity: 0; transform: translateX(-6px); }
  }

  /* ===== Cabecera ===== */
  .desk__bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--color-border-soft);
    padding: 0 0 1.1rem 4.5rem;
  }
  .desk__brand {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    margin-right: auto;
  }
  .desk__logo {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    background: var(--ab-primary);
    color: var(--ab-on-solid);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    border: 1px solid var(--border-uiverse);
    flex-shrink: 0;
  }
  .desk__company {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  .desk__brandline {
    font-size: 0.72rem;
    color: var(--color-faint);
    line-height: 1.2;
    margin-top: 0.15rem;
  }
  .desk__brandline span { color: var(--ab-primary); }

  .desk__controls { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .desk__ctl {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-uiverse);
    background: var(--color-card);
    box-shadow: var(--shadow-uiverse);
    transform: translateY(1px);
    color: var(--color-muted-foreground);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .desk__ctl:hover {
    box-shadow: var(--shadow-uiverse-hover);
    transform: translateY(-2px);
  }
  .desk__bell { width: 2.75rem; justify-content: center; position: relative; }
  .desk__bell::after {
    content: '';
    position: absolute;
    top: -0.3rem;
    right: -0.3rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: var(--radius-sm);
    background: var(--ab-warn);
    border: 2px solid var(--ab-warn);
  }
