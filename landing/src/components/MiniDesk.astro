---
/*
 * Maqueta del escritorio real de Abasto — lo más fiel posible al diseño del
 * código (frontend/src/pages/escritorio-page.tsx):
 *   marca + saludo + controles  →  "Para mirar hoy" (chips)  →  "11 módulos"
 *   →  grilla de tarjetas: barra de color + chip por módulo, dato grande,
 *   contexto, punto de aviso y motivo de línea.
 *
 * Exageración de la capa de IA: la tarjeta de Ventas trae un mini gráfico
 * (como el del módulo Ventas) y la sección de la landing le monta encima un
 * panel de "IA" — ver src/sections/Escritorio.astro.
 *
 * Nombre de empresa: demo neutro (no el de la captura, por marca).
 * Colores: tomados de la captura del escritorio real de Gaston.
 * TO-DO: pegar los hex exactos del HUES de frontend/src/lib/modules.tsx.
 */
import Sparkbars from './Sparkbars.astro';
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);

type Tile = {
  key: string;
  name: { es: string; en: string };
  hue: string;
  data: { es: string; en: string } | string;
  hint: { es: string; en: string };
  dot?: 'warn' | 'hot';
  icon: string;
  motif: string;
};

const tiles: Tile[] = [
  {
    key: 'caja', name: { es: 'Caja', en: 'Register' }, hue: '#1b9c86',
    data: { es: 'Abierta', en: 'Open' }, hint: { es: '$ 5.000 · caja 1', en: '$5,000 · register 1' },
    icon: '<rect x="2" y="8" width="20" height="12" rx="1.5"/><path d="M2 13h20M6 8V4h9l3 4"/>',
    motif: '<rect x="2" y="8" width="20" height="12" rx="1.5"/><path d="M2 13h20M6 8V4h9l3 4"/><circle cx="16.5" cy="16" r="1.5"/>',
  },
  {
    key: 'clientes', name: { es: 'Clientes', en: 'Customers' }, hue: '#d64488',
    data: '$ 288 k', hint: { es: 'En la calle · 1 cliente vencido', en: 'Owed · 1 account overdue' }, dot: 'hot',
    icon: '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0M16 6.5a3 3 0 0 1 0 6"/>',
    motif: '<circle cx="8" cy="8" r="3.4"/><path d="M2 21c.8-4.4 3.6-6.6 6-6.6S13.2 16.6 14 21"/><circle cx="17" cy="9" r="2.6"/><path d="M15 21c.4-2.6 1.4-4.4 3-5.2"/>',
  },
  {
    key: 'ventas', name: { es: 'Ventas', en: 'Sales' }, hue: '#3f6bce',
    data: '$ 58 k', hint: { es: '−36 % vs ayer · 4 tickets hoy', en: '−36% vs yesterday · 4 tickets today' },
    icon: '<rect x="4" y="3" width="13" height="18" rx="1.5"/><path d="M8 8h5M8 12h5M8 16h3"/>',
    motif: '<path d="M3 21V13M9 21V7M15 21v-6M21 21V4"/>',
  },
  {
    key: 'stock', name: { es: 'Stock', en: 'Stock' }, hue: '#e17a2b',
    data: { es: '2 bajo mínimo', en: '2 below min' },
    hint: { es: 'Coca cola 2.25l retornable, papel higiénico elegante x4', en: 'Coke 2.25l returnable, Elegante toilet paper x4' }, dot: 'hot',
    icon: '<path d="M3 8l9-4 9 4-9 4-9-4z"/><path d="M3 8v8l9 4 9-4V8"/>',
    motif: '<path d="M3 8l9-4 9 4-9 4-9-4z"/><path d="M3 8v8l9 4 9-4V8M12 12v8"/>',
  },
  {
    key: 'vencimientos', name: { es: 'Vencimientos', en: 'Expiry' }, hue: '#1b9fb5',
    data: '4 lotes', hint: { es: 'Vencen en ≤ 2 días · jamón cocido cagnoli feteado x kg', en: 'Expire within 2 days · sliced cooked ham per kg' }, dot: 'warn',
    icon: '<rect x="4" y="4" width="16" height="17" rx="1.5"/><path d="M4 9h16M9 3v4M15 3v4"/>',
    motif: '<rect x="4" y="4" width="16" height="17" rx="1.5"/><path d="M4 9h16M9 3v4M15 3v4M14 14l4 4M18 14l-4 4"/>',
  },
  {
    key: 'turnos', name: { es: 'Turnos de caja', en: 'Cash shifts' }, hue: '#5a54d4',
    data: { es: '1 turno abierto', en: '1 shift open' }, hint: { es: 'Aperturas, cierres y arqueos', en: 'Opens, closes and counts' },
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2.5"/>',
    motif: '<circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2.5"/>',
  },
  {
    key: 'reposicion', name: { es: 'Reposición', en: 'Restock' }, hue: '#e0951c',
    data: '2', hint: { es: 'Productos para pedir', en: 'Products to reorder' }, dot: 'warn',
    icon: '<path d="M4 12a8 8 0 0 1 8-8c3 0 5.6 1.7 7 4M20 4v4h-4"/><path d="M20 12a8 8 0 0 1-8 8c-3 0-5.6-1.7-7-4M4 20v-4h4"/>',
    motif: '<path d="M4 12a8 8 0 018-8c3 0 5.6 1.7 7 4M20 4v4h-4"/><path d="M20 12a8 8 0 01-8 8c-3 0-5.6-1.7-7-4M4 20v-4h4"/>',
  },
  {
    key: 'productos', name: { es: 'Productos', en: 'Products' }, hue: '#8f47d0',
    data: '5.963', hint: { es: 'Activos · 5928 sin categoría · 5928 sin precio', en: 'Active · 5928 uncategorised · 5928 no price' },
    icon: '<rect x="3" y="3" width="18" height="18" rx="1.5"/><path d="M7 3v18M11 3v18M15 7h6M15 12h6M15 16h6"/>',
    motif: '<rect x="3" y="3" width="18" height="18" rx="1.5"/><path d="M7 3v18M11 3v18M15 7h6M15 12h6M15 16h6"/>',
  },
  {
    key: 'precios', name: { es: 'Precios', en: 'Prices' }, hue: '#d63d5c',
    data: { es: 'Sin pendientes', en: 'Nothing pending' }, hint: { es: 'Costos trasladados a precio', en: 'Costs carried into prices' },
    icon: '<path d="M3 12V4h8l10 10-8 8L3 12z"/><circle cx="8" cy="9" r="1.8"/>',
    motif: '<path d="M3 12V4h8l10 10-8 8L3 12z"/><circle cx="8" cy="9" r="1.8"/>',
  },
  {
    key: 'proveedores', name: { es: 'Proveedores', en: 'Suppliers' }, hue: '#2f92cf',
    data: '4', hint: { es: 'Proveedores activos', en: 'Active suppliers' },
    icon: '<path d="M2 7h12v10H2zM14 10h4l4 4v3h-8z"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>',
    motif: '<path d="M2 7h12v10H2zM14 10h4l4 4v3h-8z"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>',
  },
  {
    key: 'depositos', name: { es: 'Depósitos', en: 'Warehouses' }, hue: '#3f4a54',
    data: '3', hint: { es: 'Dónde se guarda el stock de la sucursal', en: 'Where the branch keeps its stock' },
    icon: '<path d="M3 21V9l9-5 9 5v12M3 21h18M9 21v-6h6v6"/>',
    motif: '<path d="M3 21V9l9-5 9 5v12M3 21h18M9 21v-6h6v6"/>',
  },
];

const L = {
  es: {
    company: 'Autoservicio Belgrano', date: 'Domingo, 6 de septiembre', greet: 'Buen día, Gaston.',
    ask: 'Preguntar', branch: 'Casa Central', today: 'Para mirar hoy', count: '11 módulos', config: 'Configurar',
    chips: [
      { t: '2 bajo mínimo', c: '#e0951c' },
      { t: '4 lotes por vencer', c: '#1b9fb5' },
      { t: '1 compra sin cargar', c: '#e17a2b' },
      { t: '1 cuenta vencida', c: '#d64488' },
    ],
  },
  en: {
    company: 'Autoservicio Belgrano', date: 'Sunday, 6 September', greet: 'Morning, Gaston.',
    ask: 'Ask', branch: 'Casa Central', today: 'To check today', count: '11 modules', config: 'Configure',
    chips: [
      { t: '2 below minimum', c: '#e0951c' },
      { t: '4 lots expiring', c: '#1b9fb5' },
      { t: '1 purchase to load', c: '#e17a2b' },
      { t: '1 account overdue', c: '#d64488' },
    ],
  },
}[lang];

const ventasBars = [58, 61, 44, 66, 72, 96, 70];
---

<div class="desk" role="img" aria-label={lang === 'es'
  ? 'El escritorio de Abasto: el saludo del día, los avisos de lo pendiente y una tarjeta por módulo con su número'
  : "Abasto's desk: the day's greeting, pending items and one card per module with its number"}>
  <div class="desk__bar">
    <div class="desk__brand">
      <span class="desk__logo" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20 12 5l8 15M8 15h8"/></svg>
      </span>
      <div>
        <p class="desk__company">{L.company}</p>
        <p class="desk__brandline">abasto<span>.ai</span></p>
      </div>
    </div>
    <div class="desk__controls" aria-hidden="true">
      <span class="desk__pill">{L.branch} ▾</span>
      <span class="desk__pill desk__pill--ask">✦ {L.ask} <kbd>Ctrl K</kbd></span>
      <span class="desk__pill desk__pill--icon">☀</span>
      <span class="desk__pill">G · Gaston ▾</span>
    </div>
  </div>

  <p class="desk__date">{L.date}</p>
  <p class="desk__greet">{L.greet}</p>

  <p class="desk__today-label">{L.today}</p>
  <div class="desk__chips">
    {L.chips.map((c) => (
      <span class="desk__chip-today">
        <span class="desk__chip-dot" style={`background:${c.c}`}></span>
        {c.t}
        <span class="desk__chip-arrow" aria-hidden="true">→</span>
      </span>
    ))}
  </div>

  <div class="desk__count">
    <span>{L.count}</span>
    <span class="desk__config" aria-hidden="true">⚙ {L.config}</span>
  </div>

  <div class="desk__grid">
    {
      tiles.map((tl) => (
        <article class="desk__tile" style={`--hue:${tl.hue}`}>
          <div class="desk__tile-top">
            <span class="desk__chip" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={tl.icon} />
            </span>
            {tl.dot && <span class:list={['desk__dot', `desk__dot--${tl.dot}`]} aria-hidden="true" />}
          </div>
          <p class="desk__name">{tl.name[lang]}</p>
          <p class="desk__data">{typeof tl.data === 'string' ? tl.data : tl.data[lang]}</p>
          <p class="desk__hint">{tl.hint[lang]}</p>
          {tl.key === 'ventas' && (
            <div class="desk__spark">
              <Sparkbars values={ventasBars} highlight={5} color={tl.hue} height={26} />
            </div>
          )}
          <svg class="desk__motif" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={tl.motif} />
        </article>
      ))
    }
  </div>
</div>

<style>
  .desk {
    border-radius: var(--radius-lg);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-hero);
    padding: clamp(1rem, 0.7rem + 1.2vw, 1.6rem);
    container-type: inline-size;
  }

  .desk__bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .desk__brand { display: flex; gap: 0.6rem; align-items: center; }
  .desk__logo {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    background: #e0662e;
    color: #fff;
    flex-shrink: 0;
  }
  .desk__company {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  .desk__brandline {
    font-size: 0.68rem;
    color: var(--color-faint);
    line-height: 1.2;
  }
  .desk__brandline span { color: var(--ab-primary); }

  .desk__controls { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .desk__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.66rem;
    padding: 0.3rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    color: var(--color-muted-foreground);
    white-space: nowrap;
  }
  .desk__pill--ask {
    border-color: var(--ab-primary-line);
    background: var(--ab-primary-soft);
    color: var(--ab-primary);
    font-weight: 600;
  }
  .desk__pill--ask kbd {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    padding: 0.05rem 0.25rem;
    border-radius: 3px;
    background: color-mix(in oklab, var(--ab-primary) 15%, transparent);
  }
  .desk__pill--icon { padding-inline: 0.4rem; }

  .desk__date {
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-faint);
  }
  .desk__greet {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 0.9rem + 1vw, 1.5rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-top: 0.15rem;
  }

  .desk__today-label {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-faint);
  }
  .desk__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.45rem;
  }
  .desk__chip-today {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-foreground);
  }
  .desk__chip-dot { width: 0.4rem; height: 0.4rem; border-radius: 50%; flex-shrink: 0; }
  .desk__chip-arrow { color: var(--color-faint); }

  .desk__count {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0.9rem 0 0.6rem;
    font-size: 0.72rem;
    color: var(--color-muted-foreground);
  }
  .desk__config {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.2rem 0.45rem;
  }

  .desk__grid {
    display: grid;
    gap: 0.55rem;
    grid-template-columns: repeat(2, 1fr);
  }
  @container (min-width: 26rem) { .desk__grid { grid-template-columns: repeat(3, 1fr); } }
  @container (min-width: 40rem) { .desk__grid { grid-template-columns: repeat(4, 1fr); } }
  @container (min-width: 54rem) { .desk__grid { grid-template-columns: repeat(5, 1fr); } }

  .desk__tile {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    padding: 0.7rem 0.75rem 0.8rem 0.9rem;
    min-height: 7rem;
    display: flex;
    flex-direction: column;
    background: color-mix(in srgb, var(--hue) 7%, var(--color-card));
    border: 1px solid color-mix(in srgb, var(--hue) 28%, var(--color-border));
  }
  .desk__tile::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--hue);
  }
  .desk__tile-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.45rem;
  }
  .desk__chip {
    display: inline-grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 0.5rem;
    background: var(--hue);
    color: #fff;
  }
  .desk__dot { width: 0.42rem; height: 0.42rem; border-radius: 50%; margin-top: 0.15rem; }
  .desk__dot--warn { background: var(--ab-warn); }
  .desk__dot--hot { background: var(--ab-danger); }

  .desk__name {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-foreground);
  }
  .desk__data {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-top: 0.15rem;
    font-variant-numeric: tabular-nums;
  }
  .desk__hint {
    font-size: 0.66rem;
    line-height: 1.3;
    color: var(--color-faint);
    margin-top: 0.2rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .desk__spark { margin-top: auto; padding-top: 0.4rem; position: relative; z-index: 1; }

  .desk__motif {
    position: absolute;
    right: -0.9rem;
    bottom: -0.9rem;
    width: 4rem;
    color: var(--hue);
    opacity: 0.13;
    pointer-events: none;
  }
  :global(:root[data-theme='dark']) .desk__motif,
  :global(:root:not([data-theme='light'])) .desk__motif { opacity: 0.22; }
</style>
