---
/*
 * "El escritorio de fondo" — la metáfora del producto es el fondo de la página.
 *
 * Versión minimalista del fondo:
 *  1. color base ............ lo pone <body> (var --ab-ground)
 *  2. .bg-wash .............. un solo lavado radial cian-arena muy sutil detrás
 *                            del hero. Limpio, sin grilla, sin grano, sin latidos.
 *
 * Todo aria-hidden y detrás del contenido. Sin JS.
 */
---

<div class="bg-root" aria-hidden="true">
  <div class="bg-wash"></div>
</div>

<style>
  .bg-root {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    contain: strict;
  }

  /* lavado radial suave: cian claro arriba, se funde en el arena del body */
  .bg-wash {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 120% 55% at 50% -6rem,
      color-mix(in oklab, var(--ab-primary-soft) 70%, transparent) 0%,
      transparent 68%
    );
  }

  /* en oscuro, más presencia del cian para que no se pierda contra el fondo */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .bg-wash {
      background: radial-gradient(
        ellipse 120% 55% at 50% -6rem,
        color-mix(in oklab, var(--ab-primary) 20%, transparent) 0%,
        transparent 70%
      );
    }
  }
  :root[data-theme="dark"] .bg-wash {
    background: radial-gradient(
      ellipse 120% 55% at 50% -6rem,
      color-mix(in oklab, var(--ab-primary) 20%, transparent) 0%,
      transparent 70%
    );
  }
</style>