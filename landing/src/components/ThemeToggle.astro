---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const t = useTranslations(getLangFromUrl(Astro.url));
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label={t('nav.theme')} title={t('nav.theme')}>
  <!-- sol = claro -->
  <svg class="i i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" />
    <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4" />
  </svg>
  <!-- luna = oscuro -->
  <svg class="i i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8 8 0 1 1 10 4a6.2 6.2 0 0 0 10 10.5Z" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    color: var(--color-muted-foreground);
    background: transparent;
    cursor: pointer;
    transition: color 140ms ease, border-color 140ms ease;
  }
  .theme-toggle:hover {
    color: var(--ab-primary);
    border-color: var(--ab-primary-line);
  }
  .theme-toggle .i {
    grid-area: 1 / 1;
    display: none;
  }
  /* qué ícono se ve según el modo efectivo */
  .theme-toggle[data-mode='light'] .i-sun,
  .theme-toggle[data-mode='dark'] .i-moon {
    display: block;
  }
</style>

<script>
  type Mode = 'light' | 'dark';
  const KEY = 'abasto-landing-theme';
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const sysDark = matchMedia('(prefers-color-scheme: dark)');

  const stored = (): Mode | null => {
    try {
      const v = localStorage.getItem(KEY);
      return v === 'light' || v === 'dark' ? v : null;
    } catch {
      return null;
    }
  };

  const effective = (): Mode => stored() ?? (sysDark.matches ? 'dark' : 'light');

  const apply = (mode: Mode | null) => {
    const root = document.documentElement;
    if (mode) root.dataset.theme = mode;
    else delete root.dataset.theme;
    btn?.setAttribute('data-mode', effective());
  };

  /* arranca en auto (sigue al sistema) salvo que haya elección guardada */
  apply(stored());

  btn?.addEventListener('click', () => {
    const next: Mode = effective() === 'light' ? 'dark' : 'light';
    try {
      localStorage.setItem(KEY, next);
    } catch {}
    apply(next);
  });
</script>