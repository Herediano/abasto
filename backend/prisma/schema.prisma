generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Catálogo de referencia compartido entre todos los tenants (no pertenece a ningún tenant).
// Se usa para autocompletar nombre/marca al cargar un producto por código de barras.
model ProductReference {
  ean       String   @id
  name      String
  brand     String?
  // Rubro (Almacen, Limpieza, ...). Columna latente: hoy nada la escribe ni la
  // usa; queda para una futura clasificación del catálogo.
  category  String?
  source    String   @default("xlsx")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("product_reference")
}

enum MovementType {
  purchase_in
  sale_out
  transfer_in
  transfer_out
  adjustment_in
  adjustment_out
}

enum PurchaseInvoiceStatus {
  draft
  confirmed
  cancelled
  corrected
}

enum PurchaseInvoiceType {
  A
  B
  C
  E
  M
  other
}

enum UserRole {
  admin
  user
}

enum ShiftStatus {
  open
  closed
}

enum CashMovementType {
  deposit
  withdrawal
  expense
}

enum PaymentMethodType {
  cash
  card
  transfer
  qr
  account
}

enum CustomerAccountMovementType {
  sale
  payment
  adjustment
}

model Tenant {
  id                       String                    @id @default(uuid()) @db.Uuid
  name                     String
  legalName                String?                   @map("legal_name")
  taxId                    String?                   @unique @map("tax_id")
  status                   String                    @default("active")
  productCodeSeq           Int                       @default(0) @map("product_code_seq")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  products                 Product[]
  categories               Category[]
  suppliers                Supplier[]
  customers                Customer[]
  warehouses               Warehouse[]
  lots                     ProductLot[]
  stockMovements           StockMovement[]
  users                    User[]
  purchaseInvoices         PurchaseInvoice[]
  purchaseInvoiceLines     PurchaseInvoiceLine[]
  purchaseInvoiceRevisions PurchaseInvoiceRevision[]
  productBarcodes          ProductBarcode[]
  productSuppliers         ProductSupplier[]
  productPriceHistory      ProductPriceHistory[]
  priceLists               PriceList[]
  productPrices            ProductPrice[]
  priceRules               PriceRule[]
  roundingRules            RoundingRule[]
  priceTiers               PriceTier[]
  promotions               Promotion[]
  sales                    Sale[]
  saleLines                SaleLine[]
  saleSequences            SaleSequence[]
  salePayments             SalePayment[]
  cashRegisters            CashRegister[]
  cashShifts               CashShift[]
  cashMovements            CashMovement[]
  customerAccountMovements CustomerAccountMovement[]

  @@map("tenants")
}

// Un puesto físico de cobro dentro de una sucursal ("Caja 1", "Caja 2"). Cada
// sucursal nace con una (mismo criterio que la lista de precios "Mostrador"),
// y puede tener más si el negocio lo necesita.
model CashRegister {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  warehouseId String      @map("warehouse_id") @db.Uuid
  name        String
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId, tenantId], references: [id, tenantId])
  shifts      CashShift[]

  @@unique([id, tenantId])
  @@unique([tenantId, warehouseId, name])
  @@index([tenantId, warehouseId])
  @@map("cash_registers")
}

// Turno de caja: abre con un fondo inicial y cierra con un arqueo. Mientras
// está abierto, las ventas de esa caja y sus movimientos de efectivo le
// pertenecen; expectedCash/cashDifference se calculan recién al cerrar, sobre
// lo que pasó durante el turno (no se recalculan después: son la foto del
// cierre). Sólo puede haber un turno abierto por caja y por usuario a la vez
// — reforzado con índices únicos parciales en la migración, porque Prisma no
// declara WHERE en @@unique.
model CashShift {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  cashRegisterId String         @map("cash_register_id") @db.Uuid
  openedById     String         @map("opened_by_id") @db.Uuid
  closedById     String?        @map("closed_by_id") @db.Uuid
  status         ShiftStatus    @default(open)
  openingCash    Decimal        @map("opening_cash") @db.Decimal(14, 2)
  openingNotes   String?        @map("opening_notes")
  openedAt       DateTime       @default(now()) @map("opened_at")
  closedAt       DateTime?      @map("closed_at")
  expectedCash   Decimal?       @map("expected_cash") @db.Decimal(14, 2)
  countedCash    Decimal?       @map("counted_cash") @db.Decimal(14, 2)
  cashDifference Decimal?       @map("cash_difference") @db.Decimal(14, 2)
  closingNotes   String?        @map("closing_notes")
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  cashRegister   CashRegister   @relation(fields: [cashRegisterId, tenantId], references: [id, tenantId])
  openedBy       User           @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy       User?          @relation("ShiftClosedBy", fields: [closedById], references: [id])
  movements      CashMovement[]
  sales          Sale[]

  @@unique([id, tenantId])
  @@index([tenantId, cashRegisterId, status])
  @@index([tenantId, openedById, status])
  @@map("cash_shifts")
}

// Retiro a caja fuerte, ingreso de cambio o gasto menor pagado desde el cajón,
// durante un turno abierto. Es lo que explica que el efectivo contado no sea
// sólo fondo inicial + ventas en efectivo.
model CashMovement {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  shiftId    String           @map("shift_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       CashMovementType
  amount     Decimal          @db.Decimal(14, 2)
  reason     String
  occurredAt DateTime         @default(now()) @map("occurred_at")
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  shift      CashShift        @relation(fields: [shiftId, tenantId], references: [id, tenantId])
  user       User             @relation(fields: [userId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId, shiftId])
  @@map("cash_movements")
}

// Una venta puede pagarse con más de un medio ($30.000 efectivo + $20.000
// transferencia). Sale.paymentMethod queda como resumen ("cash" o "mixed");
// esto es el detalle. reference guarda lo que pide cada medio para poder
// cuadrar el arqueo: cupón de tarjeta, id de operación de una transferencia o
// QR — texto libre porque cada medio pide algo distinto.
model SalePayment {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  saleId    String            @map("sale_id") @db.Uuid
  method    PaymentMethodType
  amount    Decimal           @db.Decimal(14, 2)
  reference String?
  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  sale      Sale              @relation(fields: [saleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, saleId])
  @@map("sale_payments")
}

// Append-only, misma filosofía que stock_movements: nunca se edita ni se
// borra. amount positivo aumenta la deuda (venta a cuenta corriente),
// negativo la reduce (cobro). balanceAfter es la foto del saldo en ese
// momento, para que el estado de cuenta no dependa de recalcular todo desde
// el origen cada vez que se muestra.
model CustomerAccountMovement {
  id           String                      @id @default(uuid()) @db.Uuid
  tenantId     String                      @map("tenant_id") @db.Uuid
  customerId   String                      @map("customer_id") @db.Uuid
  type         CustomerAccountMovementType
  amount       Decimal                     @db.Decimal(14, 2)
  balanceAfter Decimal                     @map("balance_after") @db.Decimal(14, 2)
  saleId       String?                     @map("sale_id") @db.Uuid
  userId       String                      @map("user_id") @db.Uuid
  notes        String?
  occurredAt   DateTime                    @default(now()) @map("occurred_at")
  tenant       Tenant                      @relation(fields: [tenantId], references: [id])
  customer     Customer                    @relation(fields: [customerId, tenantId], references: [id, tenantId])
  sale         Sale?                       @relation(fields: [saleId, tenantId], references: [id, tenantId])
  user         User                        @relation(fields: [userId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId, customerId, occurredAt])
  @@map("customer_account_movements")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  products  Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("categories")
}

// Una lista puede tener precios propios o derivarse de otra con un recargo
// ("Minorista = General +40%"). Si deriva, igual admite precios explicitos que
// pisan el calculo para productos puntuales.
model PriceList {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  name          String
  isDefault     Boolean        @default(false) @map("is_default")
  derivesFromId String?        @map("derives_from_id") @db.Uuid
  markupPercent Decimal?       @map("markup_percent") @db.Decimal(6, 2)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  derivesFrom   PriceList?     @relation("PriceListDerivation", fields: [derivesFromId], references: [id])
  derivedLists  PriceList[]    @relation("PriceListDerivation")
  prices        ProductPrice[]
  priceRules    PriceRule[]
  priceTiers    PriceTier[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("price_lists")
}

// Append-only, misma filosofia que stock_movements: nunca se edita ni se borra.
// El precio vigente es la fila con validFrom mas alto que ya paso; cargar una
// fila con fecha futura ES programar el cambio, se activa sola.
model ProductPrice {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  priceListId String    @map("price_list_id") @db.Uuid
  price       Decimal   @db.Decimal(14, 2)
  validFrom   DateTime  @default(now()) @map("valid_from")
  source      String // manual | import | bulk | rule
  userId      String?   @map("user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  product     Product   @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)
  priceList   PriceList @relation(fields: [priceListId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, priceListId, productId, validFrom])
  @@index([tenantId, validFrom])
  @@map("product_prices")
}

// Criterio de actualizacion guardado: es el cuerpo de POST /prices/bulk con
// nombre, para re-aplicarlo ("Bebidas = costo +35%") sin reconfigurarlo.
model PriceRule {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  name           String
  priceListId    String    @map("price_list_id") @db.Uuid
  target         String // salePrice | costPrice
  scopeType      String    @map("scope_type") // all | category | brand
  scopeValue     String?   @map("scope_value")
  operationType  String    @map("operation_type") // percent | margin | round
  operationValue Decimal?  @map("operation_value") @db.Decimal(10, 2)
  rounding       String?
  lastRunAt      DateTime? @map("last_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  priceList      PriceList @relation(fields: [priceListId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("price_rules")
}

// Politica de redondeo por tramo de precio: un producto de $500 y otro de
// $50.000 no se redondean igual. Sin reglas cargadas no se redondea nada.
model RoundingRule {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  fromAmount Decimal  @map("from_amount") @db.Decimal(14, 2)
  toAmount   Decimal? @map("to_amount") @db.Decimal(14, 2)
  mode       String // nearest10 | nearest100 | ending99 | none
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, fromAmount])
  @@map("rounding_rules")
}

// Escala por cantidad: a partir de minQty rige este precio. Se configura ahora
// y lo consume Ventas cuando exista.
model PriceTier {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  priceListId String    @map("price_list_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  minQty      Decimal   @map("min_qty") @db.Decimal(14, 3)
  price       Decimal   @db.Decimal(14, 2)
  createdAt   DateTime  @default(now()) @map("created_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  priceList   PriceList @relation(fields: [priceListId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product     Product   @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, priceListId, productId, minQty])
  @@index([tenantId, productId])
  @@map("price_tiers")
}

// Promocion. config va en Json porque cada tipo tiene parametros distintos y
// columnas separadas quedarian casi siempre nulas (mismo criterio que
// PurchaseInvoice.otherTaxes). Se configura ahora, la aplica Ventas.
model Promotion {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  type       String // nxm | a_plus_b | percent | amount | special_price
  config     Json
  scopeType  String    @map("scope_type") // all | category | brand | ids
  scopeValue String?   @map("scope_value")
  validFrom  DateTime  @map("valid_from")
  validTo    DateTime? @map("valid_to")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, validFrom, validTo])
  @@map("promotions")
}

// Venta de mostrador. Los campos de comprobante tienen forma AFIP desde el
// principio (tipo, punto de venta, numero, CAE) aunque hoy docType sea siempre
// "internal": conectar el web service despues es completar cae/caeExpiresAt,
// no rehacer el modelo.
model Sale {
  id               String                    @id @default(uuid()) @db.Uuid
  tenantId         String                    @map("tenant_id") @db.Uuid
  warehouseId      String                    @map("warehouse_id") @db.Uuid
  customerId       String?                   @map("customer_id") @db.Uuid
  userId           String                    @map("user_id") @db.Uuid
  priceListId      String                    @map("price_list_id") @db.Uuid
  // Nulo sólo en ventas de antes de que existiera turno de caja. De acá en más
  // toda venta de mostrador se hace con un turno abierto.
  shiftId          String?                   @map("shift_id") @db.Uuid
  docType          String                    @default("internal") @map("doc_type")
  pointOfSale      String                    @map("point_of_sale")
  number           Int
  cae              String?
  caeExpiresAt     DateTime?                 @map("cae_expires_at")
  subtotal         Decimal                   @db.Decimal(14, 2)
  discountTotal    Decimal                   @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal         Decimal                   @map("tax_total") @db.Decimal(14, 2)
  total            Decimal                   @db.Decimal(14, 2)
  paymentMethod    String                    @map("payment_method") // cash | card | transfer
  status           String                    @default("confirmed") // confirmed | cancelled
  cancelReason     String?                   @map("cancel_reason")
  occurredAt       DateTime                  @default(now()) @map("occurred_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  tenant           Tenant                    @relation(fields: [tenantId], references: [id])
  warehouse        Warehouse                 @relation(fields: [warehouseId], references: [id])
  customer         Customer?                 @relation(fields: [customerId, tenantId], references: [id, tenantId])
  user             User                      @relation(fields: [userId], references: [id])
  shift            CashShift?                @relation(fields: [shiftId, tenantId], references: [id, tenantId])
  lines            SaleLine[]
  payments         SalePayment[]
  accountMovements CustomerAccountMovement[]

  @@unique([id, tenantId])
  @@unique([tenantId, docType, pointOfSale, number])
  @@index([tenantId, occurredAt])
  @@index([tenantId, shiftId])
  @@map("sales")
}

model SaleLine {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  saleId         String  @map("sale_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  productLotId   String? @map("product_lot_id") @db.Uuid
  barcode        String
  description    String
  quantity       Decimal @db.Decimal(14, 3)
  // listPrice y discountAmount se guardan aunque sean derivables: son la unica
  // forma de mostrar despues cuanto se desconto, porque las promos cambian.
  listPrice      Decimal @map("list_price") @db.Decimal(14, 2)
  unitPrice      Decimal @map("unit_price") @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  promotionId    String? @map("promotion_id") @db.Uuid
  promotionName  String? @map("promotion_name")
  taxRate        Decimal @default(21) @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal   Decimal @map("line_subtotal") @db.Decimal(14, 2)
  lineTax        Decimal @map("line_tax") @db.Decimal(14, 2)
  lineTotal      Decimal @map("line_total") @db.Decimal(14, 2)
  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  sale           Sale    @relation(fields: [saleId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product        Product @relation(fields: [productId, tenantId], references: [id, tenantId])

  @@index([tenantId, saleId])
  @@map("sale_lines")
}

// Numeracion por (tipo, punto de venta): AFIP exige una serie propia sin huecos
// para cada combinacion.
model SaleSequence {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  docType     String @map("doc_type")
  pointOfSale String @map("point_of_sale")
  lastNumber  Int    @default(0) @map("last_number")
  tenant      Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, docType, pointOfSale])
  @@map("sale_sequences")
}

model User {
  id                       String                    @id @default(uuid()) @db.Uuid
  tenantId                 String                    @map("tenant_id") @db.Uuid
  name                     String
  email                    String                    @unique
  passwordHash             String                    @map("password_hash")
  role                     UserRole                  @default(user)
  isActive                 Boolean                   @default(true) @map("is_active")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  tenant                   Tenant                    @relation(fields: [tenantId], references: [id])
  warehouseId              String?                   @map("warehouse_id") @db.Uuid
  warehouse                Warehouse?                @relation(fields: [warehouseId], references: [id])
  purchaseInvoices         PurchaseInvoice[]
  purchaseInvoiceRevisions PurchaseInvoiceRevision[]
  sales                    Sale[]
  shiftsOpened             CashShift[]               @relation("ShiftOpenedBy")
  shiftsClosed             CashShift[]               @relation("ShiftClosedBy")
  cashMovements            CashMovement[]
  customerAccountMovements CustomerAccountMovement[]

  @@index([tenantId])
  @@map("users")
}

model Product {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @map("tenant_id") @db.Uuid
  internalCode         String?               @map("internal_code")
  barcode              String
  name                 String
  description          String?
  categoryId           String?               @map("category_id") @db.Uuid
  unit                 String
  purchaseUnit         String?               @map("purchase_unit")
  unitsPerPurchase     Decimal               @default(1) @map("units_per_purchase") @db.Decimal(14, 3)
  brand                String?
  costPrice            Decimal?              @map("cost_price") @db.Decimal(14, 2)
  // CACHE del precio vigente en la lista base. La fuente de verdad es
  // ProductPrice; esto existe para que el listado pueda filtrar y ordenar por
  // precio sin resolver la vigencia fila por fila. Lo escribe unicamente
  // price-resolver.util.ts (al guardar un precio y al activar uno programado).
  salePrice            Decimal?              @map("sale_price") @db.Decimal(14, 2)
  taxRate              Decimal               @default(21) @map("tax_rate") @db.Decimal(5, 2)
  internalTaxRate      Decimal               @default(0) @map("internal_tax_rate") @db.Decimal(5, 2)
  minStock             Decimal?              @map("min_stock") @db.Decimal(14, 3)
  manejaVencimiento    Boolean               @default(false) @map("maneja_vencimiento")
  // Marca los productos creados por la carga del catálogo de referencia
  // (products/import-reference). Sirve para poder revertir esa carga en masa
  // borrando solo los que nunca tuvieron actividad.
  fromReferenceCatalog Boolean               @default(false) @map("from_reference_catalog")
  // Pesable: se vende por peso, con balanza. El código de barras trae el peso
  // embebido (prefijo 20-29) en vez de identificar sólo el producto; se
  // resuelve con parseWeighedBarcode() a partir de internalCode.
  isWeighed            Boolean               @default(false) @map("is_weighed")
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  category             Category?             @relation(fields: [categoryId], references: [id])
  lots                 ProductLot[]
  stockMovements       StockMovement[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  extraBarcodes        ProductBarcode[]
  suppliers            ProductSupplier[]
  priceHistory         ProductPriceHistory[]
  prices               ProductPrice[]
  priceTiers           PriceTier[]
  saleLines            SaleLine[]

  @@unique([id, tenantId])
  @@unique([tenantId, barcode])
  @@unique([tenantId, internalCode])
  @@index([tenantId])
  @@map("products")
}

model Supplier {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  name             String
  legalName        String?           @map("legal_name")
  taxId            String?           @map("tax_id")
  email            String?
  phone            String?
  address          String?
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  lots             ProductLot[]
  purchaseInvoices PurchaseInvoice[]
  products         ProductSupplier[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("suppliers")
}

// Codigos adicionales: un mismo producto puede venir con distintos EAN segun
// presentacion o proveedor. Product.barcode sigue siendo el principal.
model ProductBarcode {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  barcode   String
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  product   Product  @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, barcode])
  @@index([tenantId, productId])
  @@map("product_barcodes")
}

// Se completa sola al confirmar cada factura de compra: quien nos vende cada
// producto, a que codigo lo pide el proveedor y a cuanto fue la ultima compra.
model ProductSupplier {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  supplierId     String    @map("supplier_id") @db.Uuid
  supplierCode   String?   @map("supplier_code")
  lastCost       Decimal?  @map("last_cost") @db.Decimal(14, 2)
  lastPurchaseAt DateTime? @map("last_purchase_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  product        Product   @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)
  supplier       Supplier  @relation(fields: [supplierId, tenantId], references: [id, tenantId])

  @@unique([tenantId, productId, supplierId])
  @@index([tenantId, productId])
  @@map("product_suppliers")
}

// Append-only, misma filosofia que stock_movements: nunca se edita ni se borra.
// Deja rastro de cada cambio de precio y de donde vino.
model ProductPriceHistory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  field     String // 'cost' | 'sale'
  oldValue  Decimal? @map("old_value") @db.Decimal(14, 2)
  newValue  Decimal  @map("new_value") @db.Decimal(14, 2)
  source    String // 'manual' | 'import' | 'bulk' | 'invoice'
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  product   Product  @relation(fields: [productId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, productId, createdAt])
  @@map("product_price_history")
}

model Customer {
  id               String                    @id @default(uuid()) @db.Uuid
  tenantId         String                    @map("tenant_id") @db.Uuid
  name             String
  legalName        String?                   @map("legal_name")
  taxId            String?                   @map("tax_id")
  email            String?
  phone            String?
  address          String?
  priceListId      String?                   @map("price_list_id") @db.Uuid
  // Cuenta corriente. Sin límite (null) es crédito sin tope explícito; 0
  // bloquea la venta a cuenta corriente. accountBalance es CACHE — la fuente
  // de verdad es CustomerAccountMovement — y sólo lo escribe cuentas-corrientes
  // (mismo criterio que Product.salePrice con ProductPrice).
  creditLimit      Decimal?                  @map("credit_limit") @db.Decimal(14, 2)
  accountBalance   Decimal                   @default(0) @map("account_balance") @db.Decimal(14, 2)
  isActive         Boolean                   @default(true) @map("is_active")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  tenant           Tenant                    @relation(fields: [tenantId], references: [id])
  sales            Sale[]
  accountMovements CustomerAccountMovement[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("customers")
}

model Warehouse {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  name             String
  code             String
  address          String?
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  lots             ProductLot[]
  stockMovements   StockMovement[]
  purchaseInvoices PurchaseInvoice[]
  users            User[]
  sales            Sale[]
  cashRegisters    CashRegister[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

model ProductLot {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @map("tenant_id") @db.Uuid
  productId            String                @map("product_id") @db.Uuid
  warehouseId          String                @map("warehouse_id") @db.Uuid
  supplierId           String?               @map("supplier_id") @db.Uuid
  lotNumber            String                @map("lot_number")
  expirationDate       DateTime?             @map("expiration_date") @db.Date
  receivedAt           DateTime?             @map("received_at") @db.Date
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  product              Product               @relation(fields: [productId, tenantId], references: [id, tenantId])
  warehouse            Warehouse             @relation(fields: [warehouseId, tenantId], references: [id, tenantId])
  supplier             Supplier?             @relation(fields: [supplierId, tenantId], references: [id, tenantId])
  stockMovements       StockMovement[]
  purchaseInvoiceLines PurchaseInvoiceLine[]

  @@unique([id, tenantId])
  @@unique([tenantId, productId, lotNumber])
  @@index([tenantId, expirationDate])
  @@index([tenantId, warehouseId])
  @@map("product_lots")
}

model StockMovement {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  productId     String       @map("product_id") @db.Uuid
  productLotId  String?      @map("product_lot_id") @db.Uuid
  warehouseId   String       @map("warehouse_id") @db.Uuid
  quantity      Decimal      @db.Decimal(14, 3)
  movementType  MovementType @map("movement_type")
  operationId   String?      @map("operation_id") @db.Uuid
  occurredAt    DateTime     @default(now()) @map("occurred_at")
  referenceType String?      @map("reference_type")
  referenceId   String?      @map("reference_id") @db.Uuid
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  product       Product      @relation(fields: [productId, tenantId], references: [id, tenantId])
  productLot    ProductLot?  @relation(fields: [productLotId, tenantId], references: [id, tenantId])
  warehouse     Warehouse    @relation(fields: [warehouseId, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@index([tenantId, productId, warehouseId])
  @@index([tenantId, productLotId, warehouseId])
  @@index([tenantId, occurredAt])
  @@map("stock_movements")
}

model PurchaseInvoice {
  id              String                    @id @default(uuid()) @db.Uuid
  tenantId        String                    @map("tenant_id") @db.Uuid
  supplierId      String                    @map("supplier_id") @db.Uuid
  warehouseId     String                    @map("warehouse_id") @db.Uuid
  createdById     String                    @map("created_by_id") @db.Uuid
  invoiceType     PurchaseInvoiceType       @map("invoice_type")
  pointOfSale     String                    @map("point_of_sale")
  invoiceNumber   String                    @map("invoice_number")
  issueDate       DateTime                  @map("issue_date") @db.Date
  currency        String                    @default("ARS")
  subtotal        Decimal                   @db.Decimal(14, 2)
  taxTotal        Decimal                   @map("tax_total") @db.Decimal(14, 2)
  otherTaxes      Json?                     @map("other_taxes")
  otherTaxesTotal Decimal                   @default(0) @map("other_taxes_total") @db.Decimal(14, 2)
  total           Decimal                   @db.Decimal(14, 2)
  status          PurchaseInvoiceStatus     @default(draft)
  notes           String?
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  tenant          Tenant                    @relation(fields: [tenantId], references: [id])
  supplier        Supplier                  @relation(fields: [supplierId, tenantId], references: [id, tenantId])
  warehouse       Warehouse                 @relation(fields: [warehouseId, tenantId], references: [id, tenantId])
  createdBy       User                      @relation(fields: [createdById], references: [id])
  lines           PurchaseInvoiceLine[]
  revisions       PurchaseInvoiceRevision[]

  @@unique([id, tenantId])
  @@unique([tenantId, invoiceType, pointOfSale, invoiceNumber])
  @@index([tenantId, issueDate])
  @@map("purchase_invoices")
}

model PurchaseInvoiceRevision {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  invoiceId   String          @map("invoice_id") @db.Uuid
  createdById String          @map("created_by_id") @db.Uuid
  reason      String
  snapshot    Json
  createdAt   DateTime        @default(now()) @map("created_at")
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  invoice     PurchaseInvoice @relation(fields: [invoiceId, tenantId], references: [id, tenantId])
  createdBy   User            @relation(fields: [createdById], references: [id])

  @@index([tenantId, invoiceId, createdAt])
  @@map("purchase_invoice_revisions")
}

model PurchaseInvoiceLine {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  invoiceId    String          @map("invoice_id") @db.Uuid
  productId    String          @map("product_id") @db.Uuid
  productLotId String?         @map("product_lot_id") @db.Uuid
  barcode      String
  description  String
  quantity     Decimal         @db.Decimal(14, 3)
  // Factor congelado al confirmar: si el producto cambia de bulto despues, las
  // reversiones de esta factura tienen que usar el factor original o el stock
  // queda descuadrado.
  unitFactor   Decimal         @default(1) @map("unit_factor") @db.Decimal(14, 3)
  unitCost     Decimal         @map("unit_cost") @db.Decimal(14, 2)
  taxRate      Decimal         @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal Decimal         @map("line_subtotal") @db.Decimal(14, 2)
  lineTax      Decimal         @map("line_tax") @db.Decimal(14, 2)
  lineTotal    Decimal         @map("line_total") @db.Decimal(14, 2)
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  invoice      PurchaseInvoice @relation(fields: [invoiceId, tenantId], references: [id, tenantId])
  product      Product         @relation(fields: [productId, tenantId], references: [id, tenantId])
  productLot   ProductLot?     @relation(fields: [productLotId, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@index([tenantId, invoiceId])
  @@map("purchase_invoice_lines")
}
